apiVersion: v1
kind: Secret
metadata:
  name: {{ aks_acr_secret_name }}
  namespace: {{ aks_namespace }}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: >-
    {{
      {
        "auths": {
          acr_login_server: {
            "username": acr_username,
            "password": acr_password,
            "auth": (acr_username ~ ":" ~ acr_password) | b64encode
          }
        }
      } | to_json | b64encode
    }}