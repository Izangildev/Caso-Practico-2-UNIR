apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend
  namespace: {{ aks_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: frontend
  template:
    metadata:
      labels:
        app: frontend
    spec:
      imagePullSecrets:
        - name: {{ aks_acr_secret_name }}
      containers:
        - name: frontend
          image: {{ aks_front_image }}
          ports:
            - containerPort: 80
          env:
            - name: REDIS
              value: "backend"